Plecs {
  Name          "activeClampPrecharge"
  Version       "4.9"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "Tsim"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-7"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-4"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% Active-clamp forward converter with clamp-capacito"
"r precharge + soft-start\n\n% Power stage\nVin   = 48;        % input voltage"
" (V)\nNp    = 2;         % primary turns\nNs    = 1;         % secondary turn"
"s\nLm    = 100e-6;    % magnetizing inductance, primary side (H)\nLk    = 0.5"
"e-6;    % leakage inductance (H)\nCc    = 470e-9;    % clamp capacitor (F)\nV"
"c0   = 0;         % clamp capacitor initial voltage (V)\nRds   = 10e-3;     %"
" MOSFET on-resistance (Ohm)\nVf    = 0.4;       % rectifier diode forward vol"
"tage (V)\nLo    = 22e-6;     % output inductor (H)\nCo    = 100e-6;    % outp"
"ut capacitor (F)\nRload = 2;         % load resistance (Ohm)\n\n% Modulation"
"\nfsw   = 200e3;     % switching frequency (Hz)\nD     = 0.4;       % final d"
"uty cycle of S1\nTpre  = 0.3e-3;    % precharge: Vin ramp time, both gates he"
"ld off (s)\nTss   = 1e-3;      % PWM soft-start ramp time after precharge (s)"
"\ntdead = 100e-9;    % dead time between S1 and S2 (s)\n\n% Simulation\nTsim "
" = 3e-3;      % simulation time (s)\n\n% Expected steady state (for reference"
")\nVc_ss   = Vin/(1-D);     % low-side clamp capacitor voltage = peak drain v"
"oltage\nVout_ss = Vin*D*Ns/Np;   % ideal forward-converter output\n"
  InitialState  "1"
  SystemState   ""
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
  MatrixSignificanceCheck "2"
  RemoveUnusedStateSpaceOutputs "2"
  EnableStateSpaceSplitting "2"
  DisplayStateSpaceSplitting "1"
  DiscretizationMethod "2"
  ExternalModeSettings ""
  AlgebraicLoopMethod "1"
  AlgebraicLoopTolerance "1e-6"
  ScriptsDialogGeometry ""
  ScriptsDialogSplitterPos "0"
  Schematic {
    Location      [0, 24; 1539, 825]
    ZoomFactor    1
    SliderPosition [0, 0]
    ShowBrowser   off
    BrowserWidth  100
    Component {
